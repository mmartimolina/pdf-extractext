@startuml class_diagram

title Diagrama de Clases - PDF ExtractExt

class FastAPIController {
    +upload_pdf()
    +listar_documentos()
    +obtener_documento()
    +actualizar_documento()
    +eliminar_documento()
    +health_check()
}

class PDFService {
    +extract_text()
}

class AIService {
    +summarize_text()
}

class ChecksumService {
    +calcular_checksum()
}

class DocumentRepository {
    +guardar_documento()
    +obtener_todos()
    +obtener_por_checksum()
    +actualizar_documento()
    +eliminar_documento()
}

class Documento {
    -filename
    -texto
    -resumen
    -checksum
    -created_at
    -updated_at
}

FastAPIController --> PDFService
FastAPIController --> AIService
FastAPIController --> ChecksumService
FastAPIController --> DocumentRepository
DocumentRepository --> Documento

@enduml